# --- Supabase (server-side only; do NOT prefix with NEXT_PUBLIC_) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Dashboard -> Project Settings -> API -> service_role

# --- App secrets (set as Cloudflare secrets: `wrangler secret put NAME`) ---
RAWAFD_AUTH_SECRET=                   # >= 32 random chars:  openssl rand -base64 48
DEFAULT_ADMIN_PASSWORD=               # only used if an admin must be bootstrapped; users are forced to change it
NEXT_PUBLIC_APP_URL=https://your-domain.example
EMAIL_PROVIDER=resend                 # or smtp
RESEND_API_KEY=
